# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/meditime?sslmode=require

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL this API is reachable at (used by Better Auth for callback/cookie config)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (Expo dev URL + app scheme)
CORS_ORIGIN=http://localhost:8081,meditime://

PORT=3000

# Only set this when deployed behind a reverse proxy/load balancer, so
# express-rate-limit sees the real client IP instead of the proxy's. Use a hop
# count (e.g. 1) or a trusted CIDR per your host's docs. Leave unset for local dev.
# TRUST_PROXY=1
